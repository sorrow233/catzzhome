{
  "name": "catzzhome",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "description": "沉浸式雨夜浏览器起始页",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:seo && vite",
    "build:seo": "node scripts/generate-seo.js",
    "build": "npm run build:seo && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run --coverage.enabled=false",
    "check": "npm run lint && npm run test:run && npm run build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name catzzhome --branch main"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^3.4.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
